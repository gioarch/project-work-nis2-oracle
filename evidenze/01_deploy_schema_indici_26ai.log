SQL> -- DIPENDENZE: dipendenze tecniche asset->asset.
SQL> -- PK: id_dipendenza. FK: id_asset_origine e id_asset_richiesto.
SQL> -- Vincoli: niente auto-dipendenze e unicita della coppia origine/richiesto.
SQL> CREATE TABLE dipendenze (
  2      id_dipendenza      NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      id_asset_origine   NUMBER(10) NOT NULL,
  4      id_asset_richiesto NUMBER(10) NOT NULL,
  5      tipo_dipendenza    VARCHAR2(100) NOT NULL,
  6      descrizione        VARCHAR2(500),
  7  
  8      CONSTRAINT pk_dipendenze
  9          PRIMARY KEY (id_dipendenza),
 10  
 11      CONSTRAINT fk_dip_origine
 12          FOREIGN KEY (id_asset_origine)
 13          REFERENCES asset (id_asset),
 14  
 15      CONSTRAINT fk_dip_richiesto
 16          FOREIGN KEY (id_asset_richiesto)
 17          REFERENCES asset (id_asset),
 18  
 19      CONSTRAINT uq_dip_orig_req
 20          UNIQUE (id_asset_origine, id_asset_richiesto),
 21  
 22      CONSTRAINT ck_dip_no_self
 23          CHECK (id_asset_origine <> id_asset_richiesto)
 24  );

Table DIPENDENZE created.

