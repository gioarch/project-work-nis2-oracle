SQL> 
SQL> -- Le chiavi surrogate utilizzano GENERATED BY DEFAULT AS IDENTITY.
SQL> -- START WITH 1000 evita collisioni con il dataset dimostrativo,
SQL> -- che nello Step 8 utilizzerà ID espliciti nell'intervallo basso.
SQL> 
SQL> -- ORGANIZZAZIONI: anagrafica dell'organizzazione del caso di studio.
SQL> -- PK: id_organizzazione. FK: nessuna. Vincoli principali: nome obbligatorio.
SQL> CREATE TABLE organizzazioni (
  2      id_organizzazione   NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      nome_organizzazione VARCHAR2(150) NOT NULL,
  4  
  5      CONSTRAINT pk_organizzazioni
  6          PRIMARY KEY (id_organizzazione)
  7  );

Table ORGANIZZAZIONI created.

SQL> 
SQL> -- FORNITORI: anagrafica dei fornitori esterni.
SQL> -- PK: id_fornitore. FK: nessuna. Vincoli principali: nome obbligatorio.
SQL> CREATE TABLE fornitori (
  2      id_fornitore   NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      nome_fornitore VARCHAR2(150) NOT NULL,
  4  
  5      CONSTRAINT pk_fornitori
  6          PRIMARY KEY (id_fornitore)
  7  );

Table FORNITORI created.

SQL> 
SQL> -- ASSET: censimento degli asset dell'organizzazione.
SQL> -- PK: id_asset. FK: id_organizzazione. Vincoli: criticita e stato nei domini canonici.
SQL> CREATE TABLE asset (
  2      id_asset          NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      id_organizzazione NUMBER(10) NOT NULL,
  4      nome_asset        VARCHAR2(150) NOT NULL,
  5      tipo_asset        VARCHAR2(80) NOT NULL,
  6      criticita         VARCHAR2(10) NOT NULL,
  7      stato             VARCHAR2(10) NOT NULL,
  8  
  9      CONSTRAINT pk_asset
 10          PRIMARY KEY (id_asset),
 11  
 12      CONSTRAINT fk_asset_organizzazione
 13          FOREIGN KEY (id_organizzazione)
 14          REFERENCES organizzazioni (id_organizzazione),
 15  
 16      CONSTRAINT ck_asset_criticita
 17          CHECK (criticita IN ('BASSA', 'MEDIA', 'ALTA', 'CRITICA')),
 18  
 19      CONSTRAINT ck_asset_stato
 20          CHECK (stato IN ('ATTIVO', 'INATTIVO', 'DISMESSO'))
 21  );

Table ASSET created.

SQL> 
SQL> -- SERVIZI: censimento dei servizi erogati.
SQL> -- PK: id_servizio. FK: id_organizzazione. Vincolo: criticita nel dominio canonico.
SQL> CREATE TABLE servizi (
  2      id_servizio       NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      id_organizzazione NUMBER(10) NOT NULL,
  4      nome_servizio     VARCHAR2(150) NOT NULL,
  5      criticita         VARCHAR2(10) NOT NULL,
  6  
  7      CONSTRAINT pk_servizi
  8          PRIMARY KEY (id_servizio),
  9  
 10      CONSTRAINT fk_servizi_organizzazione
 11          FOREIGN KEY (id_organizzazione)
 12          REFERENCES organizzazioni (id_organizzazione),
 13  
 14      CONSTRAINT ck_servizi_criticita
 15          CHECK (criticita IN ('BASSA', 'MEDIA', 'ALTA', 'CRITICA'))
 16  );

Table SERVIZI created.

SQL> 
SQL> -- RESPONSABILI: persone con responsabilita organizzativa o tecnica.
