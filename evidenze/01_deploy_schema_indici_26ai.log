SQL> PROMPT === CREAZIONE INDICI ===
=== CREAZIONE INDICI ===
SQL> @sql/02_indexes.sql
SQL> -- ============================================================
SQL> -- Project Work L-31
SQL> -- STEP 7 - Indici Oracle aggiuntivi
SQL> -- Modello dati canonico V2
SQL> -- File: 02_indexes.sql
SQL> --
SQL> -- Contiene esclusivamente indici NON già coperti da PK/UNIQUE.
SQL> -- VALIDAZIONE: statica e logico-referenziale.
SQL> -- NON risulta eseguito su un'istanza Oracle in questa fase.
SQL> -- ============================================================
SQL> 
SQL> -- TRADE-OFF GENERALE:
SQL> -- Gli indici aggiuntivi possono velocizzare JOIN e ricerche coerenti con le query previste,
SQL> -- ma aumentano spazio occupato e costo di INSERT/UPDATE/DELETE.
SQL> -- Per questo il progetto mantiene soltanto tre indici aggiuntivi realmente motivati.
SQL> 
SQL> -- Q6: partendo da un servizio, facilita il recupero degli asset associati.
SQL> -- La PK di asset_servizi è (id_asset, id_servizio), quindi non ha
SQL> -- id_servizio come colonna iniziale.
SQL> CREATE INDEX idx_asset_servizi_servizio
  2      ON asset_servizi (id_servizio);

Index IDX_ASSET_SERVIZI_SERVIZIO created.

SQL> 
SQL> -- Q4/Q5: partendo da un responsabile, facilita il recupero degli asset
SQL> -- di competenza. La PK è (id_asset, id_responsabile).
SQL> CREATE INDEX idx_asset_resp_responsabile
  2      ON asset_responsabili (id_responsabile);

Index IDX_ASSET_RESP_RESPONSABILE created.

SQL> 
SQL> -- Q4/Q5: partendo da un responsabile, facilita il recupero dei servizi
SQL> -- di competenza. La PK è (id_servizio, id_responsabile).
SQL> CREATE INDEX idx_servizi_resp_responsabile
  2      ON servizi_responsabili (id_responsabile);

Index IDX_SERVIZI_RESP_RESPONSABILE created.

SQL> 
SQL> -- NON viene creato idx_asset_criticita.
SQL> -- Motivo: criticita ha un dominio di soli quattro valori e il dataset
SQL> -- dimostrativo è piccolo; un B-tree dedicato avrebbe selettività limitata.
SQL> -- La decisione evita un indice poco giustificato e il relativo costo
SQL> -- aggiuntivo in spazio e operazioni di scrittura.
