SQL> -- PUNTI_CONTATTO: recapiti associati a un responsabile e a una funzione.
SQL> -- PK: id_punto_contatto. FK: id_responsabile.
SQL> -- Vincoli: priorita positiva, unicita responsabile/funzione/priorita, almeno un recapito.
SQL> CREATE TABLE punti_contatto (
  2      id_punto_contatto NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      id_responsabile   NUMBER(10) NOT NULL,
  4      funzione          VARCHAR2(120) NOT NULL,
  5      priorita_contatto NUMBER(2) NOT NULL,
  6      email             VARCHAR2(150),
  7      telefono          VARCHAR2(30),
  8  
  9      CONSTRAINT pk_punti_contatto
 10          PRIMARY KEY (id_punto_contatto),
 11  
 12      CONSTRAINT fk_pcont_responsabile
 13          FOREIGN KEY (id_responsabile)
 14          REFERENCES responsabili (id_responsabile),
 15  
 16      CONSTRAINT uq_pcont_resp_fun_prio
 17          UNIQUE (id_responsabile, funzione, priorita_contatto),
 18  
 19      CONSTRAINT ck_pcont_priorita
 20          CHECK (priorita_contatto > 0),
 21  
 22      CONSTRAINT ck_pcont_recapito
 23          CHECK (email IS NOT NULL OR telefono IS NOT NULL)
 24  );

Table PUNTI_CONTATTO created.

