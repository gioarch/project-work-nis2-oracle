SQL> @sql/04_views.sql
SQL> -- ============================================================
SQL> -- Project Work L-31
SQL> -- STEP 10 - VIEW di export
SQL> -- Modello dati canonico V2 - BLOCCATO
SQL> -- File: 04_views.sql
SQL> --
SQL> -- VALIDAZIONE: statica, sintattica e logico-referenziale.
SQL> -- NON risulta eseguito su un'istanza Oracle in questa fase.
SQL> -- ============================================================
SQL> 
SQL> -- La VIEW vw_export_nis2_demo è una soluzione didattica sviluppata per
SQL> -- soddisfare la richiesta di estrazione strutturata del Project Work.
SQL> -- I campi selezionati sono campi minimi progettuali derivati dal modello dati
SQL> -- e dalla traccia. La VIEW e il relativo CSV non riproducono la Piattaforma
SQL> -- ACN, il modello ufficiale di categorizzazione né un tracciato CSV ufficiale
SQL> -- ACN.
SQL> 
SQL> -- La granularità è una riga per servizio. Le informazioni collegate sono
SQL> -- aggregate separatamente per evitare prodotti moltiplicativi involontari
SQL> -- tra asset, fornitori, responsabili e punti di contatto.
SQL> CREATE OR REPLACE VIEW vw_export_nis2_demo AS
  2  SELECT
  3      o.id_organizzazione,
  4      o.nome_organizzazione,
  5      s.id_servizio,
  6      s.nome_servizio,
  7      s.criticita,
  8      (
  9          SELECT LISTAGG(
 10                     a.nome_asset || ' [' || a.tipo_asset || '; '
 11                     || a.criticita || '; ' || a.stato || ']',
 12                     ' | '
 13                 ) WITHIN GROUP (ORDER BY a.nome_asset)
 14          FROM asset_servizi ass
 15          JOIN asset a
 16              ON a.id_asset = ass.id_asset
 17          WHERE ass.id_servizio = s.id_servizio
 18      ) AS asset_associati,
 19      (
 20          SELECT LISTAGG(
 21                     f.nome_fornitore || ' [' || sf.tipo_dipendenza || '; '
 22                     || sf.criticita_dipendenza || ']',
 23                     ' | '
 24                 ) WITHIN GROUP (ORDER BY f.nome_fornitore)
 25          FROM servizi_fornitori sf
 26          JOIN fornitori f
 27              ON f.id_fornitore = sf.id_fornitore
 28          WHERE sf.id_servizio = s.id_servizio
 29      ) AS fornitori_associati,
 30      (
 31          SELECT LISTAGG(
 32                     r.nome || ' ' || r.cognome || ' [' || r.ruolo || ']',
 33                     ' | '
 34                 ) WITHIN GROUP (ORDER BY r.cognome, r.nome)
 35          FROM servizi_responsabili sr
 36          JOIN responsabili r
 37              ON r.id_responsabile = sr.id_responsabile
 38          WHERE sr.id_servizio = s.id_servizio
 39      ) AS responsabili_associati,
 40      (
 41          SELECT LISTAGG(
 42                     r.nome || ' ' || r.cognome || ' [' || pc.funzione
 43                     || '; priorita ' || TO_CHAR(pc.priorita_contatto, 'FM99')
 44                     || '; email ' || NVL(pc.email, '-')
 45                     || '; tel ' || NVL(pc.telefono, '-') || ']',
 46                     ' | '
 47                 ) WITHIN GROUP (
 48                     ORDER BY r.cognome, r.nome, pc.funzione, pc.priorita_contatto
 49                 )
 50          FROM servizi_responsabili sr
 51          JOIN responsabili r
 52              ON r.id_responsabile = sr.id_responsabile
 53          JOIN punti_contatto pc
 54              ON pc.id_responsabile = r.id_responsabile
 55          WHERE sr.id_servizio = s.id_servizio
 56      ) AS punti_contatto_associati
 57  FROM servizi s
 58  JOIN organizzazioni o
 59      ON o.id_organizzazione = s.id_organizzazione;

