SQL> -- Q9 - Dipendenze tecniche tra asset
SQL> -- La semantica e: l'asset origine dipende dal funzionamento dell'asset richiesto.
SQL> SELECT
  2      d.id_dipendenza,
  3      ao.id_asset AS id_asset_origine,
  4      ao.nome_asset AS asset_origine,
  5      ar.id_asset AS id_asset_richiesto,
  6      ar.nome_asset AS asset_richiesto,
  7      d.tipo_dipendenza,
  8      d.descrizione
  9  FROM dipendenze d
 10  JOIN asset ao
 11      ON ao.id_asset = d.id_asset_origine
 12  JOIN asset ar
 13      ON ar.id_asset = d.id_asset_richiesto
 14  ORDER BY ao.nome_asset, ar.nome_asset;

