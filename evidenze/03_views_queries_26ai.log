SQL> -- Q6 - Riepilogo di uno specifico servizio
SQL> -- Le tre aggregazioni correlate evitano combinazioni artificiali fra insiemi indipendenti.
SQL> -- Nel dataset dimostrativo id_servizio = 1 identifica Gestione Portale Clienti.
SQL> SELECT
  2      s.id_servizio,
  3      s.nome_servizio,
  4      s.criticita,
  5      (
  6          SELECT LISTAGG(a.nome_asset, ', ')
  7                     WITHIN GROUP (ORDER BY a.nome_asset)
  8          FROM asset_servizi ass
  9          JOIN asset a
 10              ON a.id_asset = ass.id_asset
 11          WHERE ass.id_servizio = s.id_servizio
 12      ) AS asset_associati,
 13      (
 14          SELECT LISTAGG(f.nome_fornitore, ', ')
 15                     WITHIN GROUP (ORDER BY f.nome_fornitore)
 16          FROM servizi_fornitori sf
 17          JOIN fornitori f
 18              ON f.id_fornitore = sf.id_fornitore
 19          WHERE sf.id_servizio = s.id_servizio
 20      ) AS fornitori_associati,
 21      (
 22          SELECT LISTAGG(r.nome || ' ' || r.cognome, ', ')
 23                     WITHIN GROUP (ORDER BY r.cognome, r.nome)
 24          FROM servizi_responsabili sr
 25          JOIN responsabili r
 26              ON r.id_responsabile = sr.id_responsabile
 27          WHERE sr.id_servizio = s.id_servizio
 28      ) AS responsabili_associati
 29  FROM servizi s
 30  WHERE s.id_servizio = 1;

