SQL> PROMPT === T07 - Coerenza dell'ultimo snapshot con lo stato corrente ===
=== T07 - Coerenza dell'ultimo snapshot con lo stato corrente ===
SQL> SELECT 'asset' AS oggetto, COUNT(*) AS incoerenze,
  2         CASE WHEN COUNT(*) = 0 THEN 'OK' ELSE 'KO' END AS esito
  3  FROM (
  4      SELECT a.id_asset
  5      FROM asset a
  6      JOIN storico_asset sa
  7        ON sa.id_asset = a.id_asset
  8       AND sa.data_fine_validita IS NULL
  9      WHERE sa.nome_asset <> a.nome_asset
 10         OR sa.tipo_asset <> a.tipo_asset
 11         OR sa.criticita <> a.criticita
 12         OR sa.stato <> a.stato
 13  )
 14  UNION ALL
 15  SELECT 'servizi', COUNT(*),
 16         CASE WHEN COUNT(*) = 0 THEN 'OK' ELSE 'KO' END
 17  FROM (
 18      SELECT s.id_servizio
 19      FROM servizi s
 20      JOIN storico_servizi ss
 21        ON ss.id_servizio = s.id_servizio
 22       AND ss.data_fine_validita IS NULL
 23      WHERE ss.nome_servizio <> s.nome_servizio
 24         OR ss.criticita <> s.criticita
 25  );

