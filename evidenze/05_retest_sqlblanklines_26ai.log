SQL> -- Q4 - Responsabili associati ad asset e/o servizi
SQL> -- UNION ALL mantiene distinta la provenienza della competenza senza riferimenti polimorfici.
SQL> SELECT
  2      r.id_responsabile,
  3      r.nome || ' ' || r.cognome AS nominativo,
  4      r.ruolo,
  5      'ASSET' AS tipo_elemento,
  6      a.id_asset AS id_elemento,
  7      a.nome_asset AS elemento_competenza
  8  FROM responsabili r
  9  JOIN asset_responsabili ar
 10      ON ar.id_responsabile = r.id_responsabile
 11  JOIN asset a
 12      ON a.id_asset = ar.id_asset
 13  UNION ALL
 14  SELECT
 15      r.id_responsabile,
 16      r.nome || ' ' || r.cognome AS nominativo,
 17      r.ruolo,
 18      'SERVIZIO' AS tipo_elemento,
 19      s.id_servizio AS id_elemento,
 20      s.nome_servizio AS elemento_competenza
 21  FROM responsabili r
 22  JOIN servizi_responsabili sr
 23      ON sr.id_responsabile = r.id_responsabile
 24  JOIN servizi s
 25      ON s.id_servizio = sr.id_servizio
 26  ORDER BY nominativo, tipo_elemento, elemento_competenza;

