SQL> -- Q5 - Punti di contatto ed elementi di competenza
SQL> -- I contatti sono collegati ad asset e servizi tramite le associative dei responsabili.
SQL> SELECT
  2      r.nome || ' ' || r.cognome AS nominativo,
  3      r.ruolo,
  4      pc.funzione,
  5      pc.priorita_contatto,
  6      pc.email,
  7      pc.telefono,
  8      'ASSET' AS tipo_elemento,
  9      a.nome_asset AS elemento_competenza
 10  FROM punti_contatto pc
 11  JOIN responsabili r
 12      ON r.id_responsabile = pc.id_responsabile
 13  JOIN asset_responsabili ar
 14      ON ar.id_responsabile = r.id_responsabile
 15  JOIN asset a
 16      ON a.id_asset = ar.id_asset
 17  UNION ALL
 18  SELECT
 19      r.nome || ' ' || r.cognome AS nominativo,
 20      r.ruolo,
 21      pc.funzione,
 22      pc.priorita_contatto,
 23      pc.email,
 24      pc.telefono,
