SQL> -- Q1 - Asset critici
SQL> -- Estrae gli asset classificati CRITICA con organizzazione e stato corrente.
SQL> SELECT
  2      a.id_asset,
  3      a.nome_asset,
  4      a.tipo_asset,
  5      a.criticita,
  6      o.nome_organizzazione,
  7      a.stato
  8  FROM asset a
  9  JOIN organizzazioni o
 10      ON o.id_organizzazione = a.id_organizzazione
 11  WHERE a.criticita = 'CRITICA'
 12  ORDER BY a.nome_asset;

