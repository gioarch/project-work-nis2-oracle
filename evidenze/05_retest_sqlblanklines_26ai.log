SQL> PROMPT === T08 - Risultati significativi delle query principali ===
=== T08 - Risultati significativi delle query principali ===
SQL> SELECT requisito, righe_rilevate,
  2         CASE WHEN righe_rilevate > 0 THEN 'OK' ELSE 'KO' END AS esito
  3  FROM (
  4      SELECT 'Q1 asset critici' AS requisito, COUNT(*) AS righe_rilevate
  5      FROM asset WHERE criticita = 'CRITICA'
  6      UNION ALL
  7      SELECT 'Q2 servizi erogati', COUNT(*) FROM servizi
  8      UNION ALL
  9      SELECT 'Q3 dipendenze da terze parti', COUNT(*) FROM servizi_fornitori
 10      UNION ALL
 11      SELECT 'Q4 responsabili',
 12             (SELECT COUNT(*) FROM asset_responsabili)
 13           + (SELECT COUNT(*) FROM servizi_responsabili)
 14      FROM dual
 15      UNION ALL
 16      SELECT 'Q5 punti di contatto', COUNT(*) FROM punti_contatto
 17      UNION ALL
 18      SELECT 'Q6 riepilogo servizio', COUNT(*)
 19      FROM servizi s
 20      WHERE s.id_servizio = 1
 21        AND EXISTS (
 22            SELECT 1 FROM asset_servizi ass
 23            WHERE ass.id_servizio = s.id_servizio
 24        )
 25        AND EXISTS (
 26            SELECT 1 FROM servizi_fornitori sf
 27            WHERE sf.id_servizio = s.id_servizio
 28        )
 29        AND EXISTS (
 30            SELECT 1 FROM servizi_responsabili sr
 31            WHERE sr.id_servizio = s.id_servizio
 32        )
